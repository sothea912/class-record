rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper: Check if user is authenticated with Firebase Auth
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // Helper: Check if user is a teacher
    function isTeacher() {
      return isSignedIn() && (
        (exists(/databases/$(database)/documents/users/$(request.auth.uid))
         && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher')
        || (request.auth.token.email != null && !request.auth.token.email.endsWith('@centralacademy.app'))
        || request.auth.token.email == 'teacher@centralacademy.app'
      );
    }

    // Helper: Check if user is the specified student
    function isStudent(studentId) {
      return isSignedIn() && (
        request.auth.uid == studentId
        || (request.auth.token.email != null && request.auth.token.email == studentId + '@centralacademy.app')
        || (exists(/databases/$(database)/documents/users/$(request.auth.uid))
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.studentId == studentId)
        || (exists(/databases/$(database)/documents/students/$(studentId))
            && (
              get(/databases/$(database)/documents/students/$(studentId)).data.authUid == request.auth.uid
              || (get(/databases/$(database)/documents/students/$(studentId)).data.authEmail != null
                  && get(/databases/$(database)/documents/students/$(studentId)).data.authEmail == request.auth.token.email)
              || (get(/databases/$(database)/documents/students/$(studentId)).data.studentNo != null
                  && request.auth.token.email == get(/databases/$(database)/documents/students/$(studentId)).data.studentNo + '@centralacademy.app')
            ))
        || (resource != null && resource.data != null && (
          resource.data.authUid == request.auth.uid
          || (resource.data.authEmail != null && resource.data.authEmail == request.auth.token.email)
          || (resource.data.studentNo != null && request.auth.token.email == resource.data.studentNo + '@centralacademy.app')
          || (resource.data.id != null && request.auth.token.email == resource.data.id + '@centralacademy.app')
          || (resource.data.studentId != null && resource.data.studentId == studentId)
        ))
      );
    }

    // Public directory lookup for student authentication resolution (NO passwords, phones, or private data)
    match /student_lookup/{lookupId} {
      allow read, write: if true;
    }

    // Public Branding (App Logo & Wallpaper)
    match /public_branding/{docId} {
      allow read: if true;
      allow write: if true;
    }

    // Student Account Requests (Create-only for students requesting account restoration; Teacher-only read, update, delete)
    match /account_requests/{requestId} {
      allow create: if request.resource.data.keys().hasAll(['id', 'studentId', 'studentName', 'createdAt', 'status'])
        && request.resource.data.status == 'pending'
        && request.resource.data.studentId is string && request.resource.data.studentId.size() > 0 && request.resource.data.studentId.size() <= 128
        && request.resource.data.studentName is string && request.resource.data.studentName.size() > 0 && request.resource.data.studentName.size() <= 100
        && request.resource.data.createdAt is string && request.resource.data.createdAt.size() <= 60;
      allow read, update, delete: if isTeacher();
    }

    // Users Collection (Stores role, name, email, studentId, classIds, dashboardLayout)
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isTeacher());
      allow create: if isSignedIn() && (request.auth.uid == userId || isTeacher());
      allow update: if isSignedIn() && (
        isTeacher()
        || (request.auth.uid == userId && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']))
      );
      allow delete: if isTeacher();
    }

    // Class Joins / Self Check-ins
    match /class_joins/{joinId} {
      allow create: if isSignedIn()
        && request.resource.data.studentId == request.auth.uid
        && request.resource.data.joinedAt == request.time;
      allow read: if isTeacher() || (isSignedIn() && resource.data.studentId == request.auth.uid);
      allow update, delete: if isTeacher();
    }

    // Classes: Readable by all signed-in users, writable by teacher
    match /classes/{classId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isTeacher();
    }

    // Students: Teachers can manage all; students can read only their own document, and update allowed profile fields & password
    match /students/{studentId} {
      allow read: if isTeacher() || isStudent(studentId);
      allow create, delete: if isTeacher();
      allow update: if isTeacher() || (
        isStudent(studentId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'photo', 'gender', 'dateOfBirth', 'phone', 'parentName', 'address', 'password', 'updatedAt'
        ])
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'id', 'loginName', 'studentNo', 'classIds', 'authUid', 'authEmail', 'accountStatus', 'passwordResetStatus', 'passwordResetExpiresAt', 'role', 'roles', 'marks', 'attendance'
        ])
      );
    }

    // Subjects: Readable by all signed-in users, writable by teacher
    match /subjects/{subjectId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isTeacher();
    }

    // Attendance Sessions: Readable by signed-in users, writable by teacher;
    // Students can record their own auto-join attendance record
    match /attendance/{sessionId} {
      allow read: if isSignedIn();
      allow create: if isTeacher()
        || (isSignedIn()
            && request.resource.data.studentId != null
            && isStudent(request.resource.data.studentId)
            && request.resource.data.source == 'auto-join');
      allow update: if isTeacher();
      allow delete: if isTeacher();
    }

    // Marks / Exam Scores: Readable by signed-in users, writable by teacher
    match /marks/{markId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isTeacher();
    }

    // Classwork / Homework: Readable by signed-in users, writable by teacher
    match /classwork/{taskId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isTeacher();
    }

    // Leave Permissions: Teachers can read/manage all; Students can create & read their own
    match /permissions/{permitId} {
      allow read: if isTeacher()
        || (isSignedIn() && resource.data.studentId != null && isStudent(resource.data.studentId));
      allow create: if isTeacher()
        || (isSignedIn() && request.resource.data.studentId != null && isStudent(request.resource.data.studentId));
      allow update, delete: if isTeacher()
        || (isSignedIn() && resource.data.studentId != null && isStudent(resource.data.studentId));
    }

    // Announcement Banners: Readable by signed-in users, writable by teacher
    match /banners/{bannerId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isTeacher();
    }

    // Resource Library: Readable by signed-in users, create/delete by teacher, update by signed-in users
    match /resources/{resourceId} {
      allow read: if isSignedIn();
      allow create, delete: if isTeacher();
      allow update: if isSignedIn();
    }

    // App Settings: Readable by signed-in users, writable by teacher
    match /app_settings/{docId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isTeacher();
    }

    // Custom Imported Records: Readable by signed-in users, writable by teacher
    match /custom_records/{recordId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isTeacher();
    }

    // Class Cancellation & Rescheduling Notices
    match /classNotices/{noticeId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isTeacher();
    }

    // Student Progress (Gamification): Readable by all signed-in users, writable by teacher or student owner
    match /studentProgress/{progressId} {
      allow read: if isSignedIn();
      allow create: if isTeacher() || (isSignedIn() && request.resource.data.studentId != null && isStudent(request.resource.data.studentId));
      allow update: if isTeacher() || (isSignedIn() && resource.data.studentId != null && isStudent(resource.data.studentId));
      allow delete: if isTeacher();
    }

    // Homework Assignments: Created and managed by teachers.
    // Students can read published homework.
    match /homework/{homeworkId} {
      allow read: if isTeacher()
        || (isSignedIn() && resource.data.published == true);
      allow create, update, delete: if isTeacher();

      // Subcollection for attached homework documents (PDF, DOC <= 700KB)
      match /files/{fileId} {
        allow read: if isTeacher()
          || (isSignedIn() && get(/databases/$(database)/documents/homework/$(homeworkId)).data.published == true);
        allow create, update, delete: if isTeacher();
      }
    }

    // Homework Files root collection support
    match /homework_files/{fileId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isTeacher();
    }

    // Homework Answer Keys: Strictly TEACHER ONLY! Students have ZERO read/write access.
    match /homework_keys/{homeworkId} {
      allow read, write: if isTeacher();
    }

    // Homework Submissions: One per student per homework (ID: {homeworkId}_{studentId})
    match /homework_submissions/{submissionId} {
      allow read: if isTeacher()
        || (isSignedIn() && resource.data.studentId != null && isStudent(resource.data.studentId));
      allow create: if isTeacher() || (
        isSignedIn()
        && request.resource.data.studentId != null
        && isStudent(request.resource.data.studentId)
        && request.resource.data.id == request.resource.data.homeworkId + '_' + request.resource.data.studentId
        && request.resource.data.status in ['draft', 'submitted', 'late']
        && !request.resource.data.keys().hasAny(['score', 'questionMarks', 'questionComments', 'teacherNote', 'markedAt', 'markedBy'])
      );
      allow update: if isTeacher() || (
        isSignedIn()
        && resource.data.studentId != null
        && isStudent(resource.data.studentId)
        && resource.data.status != 'marked'
        && request.resource.data.studentId == resource.data.studentId
        && request.resource.data.homeworkId == resource.data.homeworkId
        && request.resource.data.status in ['draft', 'submitted', 'late']
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['score', 'questionMarks', 'questionComments', 'teacherNote', 'markedAt', 'markedBy'])
      );
      allow delete: if isTeacher();

      // Subcollection for student submission files (PDF, DOC, DOCX, JPG, PNG <= 750KB)
      match /files/{fileId} {
        allow read: if isTeacher()
          || (isSignedIn() && get(/databases/$(database)/documents/homework_submissions/$(submissionId)).data.studentId != null && isStudent(get(/databases/$(database)/documents/homework_submissions/$(submissionId)).data.studentId));
        allow create, update: if isTeacher() || (
          isSignedIn()
          && request.resource.data.studentId != null
          && isStudent(request.resource.data.studentId)
          && submissionId.matches('.*_' + request.resource.data.studentId + '$')
          && request.resource.data.submissionId == submissionId
          && request.resource.data.size <= 750000
          && !request.resource.data.keys().hasAny(['score', 'questionMarks', 'questionComments', 'teacherNote', 'markedAt', 'markedBy'])
        );
        allow delete: if isTeacher() || (
          isSignedIn()
          && get(/databases/$(database)/documents/homework_submissions/$(submissionId)).data.studentId != null
          && isStudent(get(/databases/$(database)/documents/homework_submissions/$(submissionId)).data.studentId)
        );
      }
    }

    // Teacher Notifications (e.g. homework/quiz/exam submitted)
    match /teacher_notifications/{notifId} {
      allow read: if isTeacher();
      allow create: if isTeacher()
        || (isSignedIn() && request.resource.data.studentId != null && isStudent(request.resource.data.studentId));
      allow update, delete: if isTeacher();
    }

    // Activities: Unified Quizzes, Exams, Custom Activities, and Homework
    match /activities/{activityId} {
      allow read: if isTeacher()
        || (isSignedIn() && resource.data.published == true);
      allow create, update, delete: if isTeacher();

      // Questions subcollection: read by teacher OR signed-in student who has started an attempt
      match /questions/{qDocId} {
        allow read: if isTeacher()
          || (isSignedIn() && (
            exists(/databases/$(database)/documents/activity_attempts/$(activityId + '_' + request.auth.uid))
            || (request.auth.token.email != null && exists(/databases/$(database)/documents/activity_attempts/$(activityId + '_' + request.auth.token.email.split('@')[0])))
            || (exists(/databases/$(database)/documents/users/$(request.auth.uid))
                && exists(/databases/$(database)/documents/activity_attempts/$(activityId + '_' + get(/databases/$(database)/documents/users/$(request.auth.uid)).data.studentId)))
          ));
        allow create, update, delete: if isTeacher();
      }

      // Attached file docs subcollection
      match /files/{fileId} {
        allow read: if isTeacher()
          || (isSignedIn() && get(/databases/$(database)/documents/activities/$(activityId)).data.published == true);
        allow create, update, delete: if isTeacher();
      }
    }

    // Activity Files root collection support
    match /activity_files/{fileId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isTeacher();
    }

    // Activity Answer Keys: Strictly TEACHER ONLY! Students have ZERO read/write access.
    match /activity_keys/{activityId} {
      allow read, write: if isTeacher();
    }

    // Activity Attempts: Student Submissions for Quizzes, Exams, and Custom Activities
    match /activity_attempts/{attemptId} {
      allow read: if isTeacher()
        || (isSignedIn() && resource.data.studentId != null && isStudent(resource.data.studentId));

      allow create: if isTeacher() || (
        isSignedIn()
        && request.resource.data.studentId != null
        && isStudent(request.resource.data.studentId)
        && request.resource.data.status in ['not_started', 'in_progress', 'submitted', 'auto_submitted']
        && !request.resource.data.keys().hasAny(['score', 'questionMarks', 'questionComments', 'teacherNote', 'markedAt', 'markedBy', 'grade', 'passed', 'sectionScores'])
      );

      allow update: if isTeacher() || (
        isSignedIn()
        && resource.data.studentId != null
        && isStudent(resource.data.studentId)
        && resource.data.status != 'marked'
        && request.resource.data.studentId == resource.data.studentId
        && request.resource.data.activityId == resource.data.activityId
        && request.resource.data.status in ['in_progress', 'submitted', 'auto_submitted']
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['score', 'questionMarks', 'questionComments', 'teacherNote', 'markedAt', 'markedBy', 'grade', 'passed', 'sectionScores', 'startedAt', 'durationMinutes', 'extraMinutesGranted', 'resultsReleased', 'retakeAllowed'])
      );

      allow delete: if isTeacher();
    }

    // Student Badges & Achievements
    match /student_badges/{badgeId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isTeacher()
        || (isSignedIn() && request.resource.data.studentId != null && isStudent(request.resource.data.studentId));
    }
  }
}
